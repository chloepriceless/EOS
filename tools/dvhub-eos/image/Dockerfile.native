# syntax=docker/dockerfile:1.7
# DVhub-EOS: native layer on top of the EOS image built from the root Dockerfile of dvhub-eos/main
# (unchanged upstream Dockerfile). Build context: native/ of the same checkout.
#   stage wheel: builds akkudoktoreos-native (Rust/PyO3, abi3) from these sources
#   final:       installs the wheel into /opt/venv and selects optimization.genetic.backend=native
# EOS uses the kernel only for GENETIC sources listed in its certified.json; otherwise it falls back
# to Python with a warning. EOS_OPTIMIZATION__GENETIC__BACKEND=python switches it off without a
# new image.
ARG BASE_IMAGE
ARG RUST_IMAGE=rust:1.99.1-slim-trixie

FROM ${RUST_IMAGE} AS wheel
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && pip3 install --break-system-packages --no-cache-dir "maturin==1.16.0" \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /native
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/native/target \
    cd akkudoktoreos-native && maturin build --release --locked --out /wheels

FROM ${BASE_IMAGE}
ARG DVHUB_EOS_VERSION=dev
ARG DVHUB_EOS_REVISION=unknown
RUN --mount=from=ghcr.io/astral-sh/uv:0.12.7,source=/uv,target=/tmp/uv \
    --mount=from=wheel,source=/wheels,target=/tmp/wheels \
    /tmp/uv pip install --python /opt/venv/bin/python --no-deps --no-cache /tmp/wheels/akkudoktoreos_native-*.whl \
    && /opt/venv/bin/python -c "import akkudoktoreos_native as n; print('akkudoktoreos_native', n.__version__)"
ENV EOS_OPTIMIZATION__GENETIC__BACKEND=native
LABEL org.opencontainers.image.title="DVhub-EOS" \
      org.opencontainers.image.version="${DVHUB_EOS_VERSION}" \
      org.opencontainers.image.revision="${DVHUB_EOS_REVISION}" \
      org.opencontainers.image.source="https://github.com/chloepriceless/EOS" \
      net.dvhub.eos.upstream="https://github.com/Akkudoktor-EOS/EOS"
